{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Campaign Manager Output",
  "description": "Campaign brief, A/B test plan, budget allocation, and daily monitoring instructions",
  "required": ["campaign_brief", "budget_allocation", "daily_monitoring_plan"],
  "properties": {
    "campaign_brief": {
      "type": "object",
      "required": ["campaign_id", "objective", "target_audience", "success_metric", "target_kpi"],
      "properties": {
        "campaign_id": {
          "type": "string",
          "description": "Unique campaign identifier (e.g., 'CAMP-2024-001')"
        },
        "objective": {
          "type": "string",
          "description": "Campaign objective in 1-2 sentences"
        },
        "target_audience": {
          "type": "string",
          "description": "Target persona and segment"
        },
        "success_metric": {
          "type": "string",
          "description": "Primary metric (e.g., 'Cost per qualified lead')"
        },
        "target_kpi": {
          "type": "number",
          "description": "Target value for success metric"
        },
        "budget_usd": {
          "type": "number"
        },
        "timeline_days": {
          "type": "integer"
        },
        "launch_date": {
          "type": "string",
          "format": "date"
        },
        "decision_date": {
          "type": "string",
          "format": "date",
          "description": "Date when we'll make scale/kill decision"
        }
      }
    },
    "ab_test_plan": {
      "type": "object",
      "properties": {
        "variable_tested": {
          "type": "string",
          "description": "What's being tested"
        },
        "control_description": {
          "type": "string"
        },
        "variant_description": {
          "type": "string"
        },
        "split_percentage": {
          "type": "object",
          "properties": {
            "control": {"type": "number"},
            "variant": {"type": "number"}
          },
          "description": "Budget split between control (%) and variant (%)"
        },
        "sample_size_needed": {
          "type": "integer",
          "description": "Minimum conversions needed for statistical significance"
        },
        "confidence_level": {
          "type": "number",
          "description": "0.95 = 95% confidence"
        },
        "expected_days_to_significance": {
          "type": "integer",
          "description": "Estimated days to reach statistical significance"
        }
      }
    },
    "budget_allocation": {
      "type": "object",
      "required": ["total_budget", "allocation_breakdown"],
      "properties": {
        "total_budget": {
          "type": "number"
        },
        "allocation_breakdown": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "budget_usd": {"type": "number"},
              "percentage": {"type": "number"},
              "daily_budget": {"type": "number"},
              "purpose": {"type": "string"}
            }
          },
          "description": "Budget by segment/audience/variant"
        },
        "contingency_reserve": {
          "type": "number",
          "description": "Budget held for scaling winning variants"
        }
      }
    },
    "launch_checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "owner", "deadline"],
        "properties": {
          "item": {"type": "string"},
          "owner": {"type": "string"},
          "deadline": {"type": "string", "format": "date"},
          "status": {
            "type": "string",
            "enum": ["pending", "in-progress", "completed"]
          }
        }
      },
      "description": "Pre-launch tasks"
    },
    "daily_monitoring_plan": {
      "type": "object",
      "required": ["metrics_to_monitor", "check_frequency", "alert_thresholds"],
      "properties": {
        "metrics_to_monitor": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Metrics checked daily (e.g., 'spend vs. pace', 'CTR vs. benchmark')"
        },
        "check_frequency": {
          "type": "string",
          "enum": ["hourly", "daily", "daily-eod", "twice-daily"],
          "description": "How often to review metrics"
        },
        "alert_thresholds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["metric", "threshold_value", "action"],
            "properties": {
              "metric": {"type": "string"},
              "threshold_value": {"type": "number"},
              "action": {"type": "string"},
              "severity": {
                "type": "string",
                "enum": ["info", "warning", "critical"]
              }
            }
          }
        },
        "pause_criteria": {
          "type": "string",
          "description": "Conditions under which to pause campaign immediately"
        },
        "escalation_process": {
          "type": "string",
          "description": "Who to notify and when"
        }
      }
    },
    "success_thresholds": {
      "type": "object",
      "properties": {
        "kill_threshold": {
          "type": "number",
          "description": "Performance level at which campaign is killed (e.g., CAC 2x target)"
        },
        "pause_threshold": {
          "type": "number",
          "description": "Performance level at which campaign is paused for review"
        },
        "scale_threshold": {
          "type": "number",
          "description": "Performance level at which campaign is scaled"
        }
      }
    },
    "reporting_cadence": {
      "type": "object",
      "properties": {
        "daily_snapshot": {"type": "string"},
        "weekly_review": {"type": "string"},
        "final_report_date": {"type": "string", "format": "date"}
      }
    }
  }
}
