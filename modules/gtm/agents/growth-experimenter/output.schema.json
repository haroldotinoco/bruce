{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Growth Experimenter Output",
  "description": "Prioritized growth experiments with sequencing and playbook opportunity identification",
  "required": ["prioritized_experiments"],
  "properties": {
    "prioritized_experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "experiment_name", "hypothesis", "success_metric", "timeline_days"],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "experiment_name": {
            "type": "string",
            "description": "Memorable experiment name"
          },
          "hypothesis": {
            "type": "string",
            "description": "Clear, falsifiable hypothesis (e.g., 'If we enable referral program, conversion will increase 15%')"
          },
          "methodology": {
            "type": "string",
            "description": "How the experiment will be executed"
          },
          "success_metric": {
            "type": "string",
            "description": "Primary metric that determines if hypothesis is confirmed"
          },
          "target_value": {
            "type": "number",
            "description": "Target value for success metric"
          },
          "target_impact": {
            "type": "string",
            "description": "Estimated impact on key business metrics (e.g., '+25% monthly signups')"
          },
          "budget_usd": {
            "type": "number",
            "description": "Budget required"
          },
          "timeline_days": {
            "type": "integer",
            "description": "Days to completion"
          },
          "resource_requirement": {
            "type": "string",
            "description": "FTE and skill types needed"
          },
          "cost_of_learning": {
            "type": "number",
            "description": "Budget spent to learn (budget / expected sample size)"
          },
          "roi_if_successful": {
            "type": "string",
            "description": "Estimated ROI if experiment succeeds and is scaled"
          },
          "go_no_go_decision_criteria": {
            "type": "string",
            "description": "Clear criteria for scaling vs. pausing"
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Other experiments or outcomes this depends on"
          },
          "risks": {
            "type": "array",
            "items": {"type": "string"},
            "description": "What could go wrong"
          }
        }
      },
      "minItems": 1,
      "maxItems": 5
    },
    "experiment_sequencing": {
      "type": "string",
      "description": "How experiments build on each other and what learnings from early experiments inform later ones"
    },
    "success_playbook_opportunity": {
      "type": "object",
      "properties": {
        "if_top_experiment_succeeds": {
          "type": "string",
          "description": "What becomes a repeatable playbook if #1 experiment succeeds?"
        },
        "scaling_path": {
          "type": "string",
          "description": "How to scale successful experiment from learnings to full production"
        },
        "team_capability_to_build": {
          "type": "array",
          "items": {"type": "string"},
          "description": "What new capabilities will team need to build for successful scaling?"
        }
      }
    },
    "resource_allocation_plan": {
      "type": "object",
      "properties": {
        "total_budget": {"type": "number"},
        "allocation_by_experiment": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        },
        "contingency_reserve": {"type": "number"}
      }
    },
    "quarterly_roadmap": {
      "type": "object",
      "properties": {
        "month_1": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Experiments to run in month 1"
        },
        "month_2": {
          "type": "array",
          "items": {"type": "string"}
        },
        "month_3": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "stopping_rules": {
      "type": "object",
      "properties": {
        "pause_if": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Conditions to pause experiment"
        },
        "kill_if": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Conditions to kill experiment and move on"
        },
        "scale_if": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Conditions to scale experiment"
        }
      }
    }
  }
}
