# =============================================================
# BRUCEAI — ENVIRONMENT VARIABLES
# Copy to .env and fill in your values.
# Never commit .env to git.
# =============================================================

# ── LLM PROVIDERS ─────────────────────────────────────────────
# You only need ONE of: direct providers OR OpenRouter.
# OpenRouter lets you access all models with a single key.

# Option A: Direct provider keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Option B: OpenRouter (recommended for cost control + fallback)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# When using OpenRouter, set model IDs with prefix like:
# "anthropic/claude-opus-4-6", "openai/gpt-4o", "google/gemini-pro"

# Which provider mode to use: "direct" | "openrouter"
LLM_PROVIDER_MODE=openrouter

# ── TEMPORAL.IO ──────────────────────────────────────────────
# Local dev: use docker-compose (TEMPORAL_ADDRESS=localhost:7233)
# Cloud: use Temporal Cloud address
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TLS_CERT=     # only needed for Temporal Cloud
TEMPORAL_TLS_KEY=      # only needed for Temporal Cloud

# ── DATABASE — PostgreSQL (Neon or local) ─────────────────────
DATABASE_URL=postgresql://bruceai:bruceai@localhost:5432/bruceai
# For Neon: postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# ── CACHE — Redis (Upstash or local) ─────────────────────────
REDIS_URL=redis://localhost:6379
# For Upstash: rediss://default:password@host.upstash.io:6379

# ── VECTOR DB — Qdrant ────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=    # leave empty for local dev

# ── AUTH — Clerk ─────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# ── PAYMENTS — Stripe ────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_METER_EVENT_ENDPOINT=

# ── FILE STORAGE — Cloudflare R2 (or local MinIO) ─────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bruceai-artifacts
R2_PUBLIC_URL=
# For local dev with MinIO:
S3_ENDPOINT=http://localhost:9000    # MinIO local endpoint
S3_BUCKET=bruceai-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── EMAIL — Resend ────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@bruceai.app

# ── OBSERVABILITY — Better Stack ─────────────────────────────
BETTERSTACK_SOURCE_TOKEN=

# ── APP CONFIG ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# ── MODULE SERVICE PORTS (local multi-service dev) ────────────
BRUCE_CORE_PORT=3001
OPPORTUNITY_PORT=3002
ADD_VENTURE_PORT=3003
BRAND_AID_PORT=3004
BUILDER_PORT=3005
GTM_PORT=3006
STARTUP_OPS_PORT=3007
PORTFOLIO_PORT=3008
BRUCE_MEMORY_PORT=3009

# ── MODULE-TO-MODULE INTERNAL URLs (local) ────────────────────
BRUCE_CORE_URL=http://localhost:3001
OPPORTUNITY_URL=http://localhost:3002
ADD_VENTURE_URL=http://localhost:3003
BRAND_AID_URL=http://localhost:3004
BUILDER_URL=http://localhost:3005
GTM_URL=http://localhost:3006
STARTUP_OPS_URL=http://localhost:3007
PORTFOLIO_URL=http://localhost:3008
BRUCE_MEMORY_URL=http://localhost:3009

# ── INTER-MODULE JWT ──────────────────────────────────────────
INTER_MODULE_JWT_SECRET=change-me-in-production-use-32-chars-min
INTER_MODULE_JWT_TTL_SECONDS=300

# ── FEATURE FLAGS ─────────────────────────────────────────────
ENABLE_HUMAN_GATE=false       # set true to require human approval at gates
ENABLE_BILLING=false          # set true to enable Stripe metering
ENABLE_SMTP=false             # set true to send emails via Resend
ENABLE_VECTOR_SEARCH=true     # set false to skip Qdrant for basic testing
