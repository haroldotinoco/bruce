{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Opportunity Analyst Input",
  "type": "object",
  "properties": {
    "raw_opportunity": {
      "type": "object",
      "properties": {
        "opportunity_title": {
          "type": "string"
        },
        "problem_statement": {
          "type": "string"
        },
        "target_segment": {
          "type": "string"
        },
        "pain_points": {
          "type": "array",
          "items": {"type": "string"}
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {"type": "string"},
              "source_title": {"type": "string"},
              "source_type": {"type": "string"}
            }
          }
        },
        "discovery_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["opportunity_title", "problem_statement", "target_segment"]
    },
    "analysis_focus": {
      "type": "object",
      "properties": {
        "depth_level": {
          "type": "string",
          "enum": ["quick_screen", "standard", "deep_dive"],
          "default": "standard"
        },
        "priority_areas": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "quality_retry": {
      "type": "object",
      "description": "Present when the pipeline re-runs analysis after a sub-threshold score; address feedback_to_address.",
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "previous_score": { "type": "number" },
        "feedback_to_address": { "type": "string" },
        "prior_scoring_summary": { "type": "string" }
      }
    }
  },
  "required": ["raw_opportunity"]
}
