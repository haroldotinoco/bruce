    "Western Europe"
  ],
  "date_range": {
    "start_date": "2024-03-30",
    "end_date": "2024-04-06"
  },
  "source_preferences": {
    "primary_sources": [
      "techcrunch.com",
      "venturebeat.com",
      "gartner.com",
      "mckinsey.com",
      "sec.gov"
    ],
    "secondary_sources": [
      "linkedin.com",
      "crunchbase.com",
      "pitchbook.com"
    ],
    "specialized_sources": [
      "industry_association_reports",
      "academic_research",
      "government_statistics",
      "patent_filings"
    ]
  },
  "quality_requirements": {
