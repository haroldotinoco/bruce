{
  "scan_themes": [
    "healthcare-admin",
    "fintech-compliance",
    "saas-infrastructure",
    "sustainability-tech"
  ],
  "filters": {
    "min_tam": 10000000,
    "max_tam": 10000000000,
    "geographic_focus": [
      "US",
      "Canada",
      "UK",
      "Germany",
      "France"
    ],
    "industry_verticals": [
      "healthcare",
      "financial-services",
      "enterprise-software",
      "supply-chain",
      "sustainability"
