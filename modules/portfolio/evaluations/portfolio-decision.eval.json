      "kill_decisions": 0,
      "human_confirmations_required": 1
    }
  },
  "scoring": {
    "scale_count": {
      "type": "exact_match",
      "expectedPath": "portfolio_summary.scale_decisions",
      "actualPath": "portfolio_summary.scale_decisions"
    },
    "iterate_count": {
      "type": "exact_match",
      "expectedPath": "portfolio_summary.iterate_decisions",
      "actualPath": "portfolio_summary.iterate_decisions"
