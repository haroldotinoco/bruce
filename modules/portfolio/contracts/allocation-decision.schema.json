{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Allocation Decision",
  "description": "Resource allocation decision for a venture",
  "type": "object",
  "properties": {
    "allocation_id": {
      "type": "string",
      "description": "Unique identifier for this allocation decision",
      "pattern": "^alloc_[a-z0-9]{12}$"
    },
    "decision_id": {
      "type": "string",
      "description": "Reference to related governance decision"
    },
    "venture_id": {
      "type": "string",
      "description": "Venture receiving allocation"
    },
    "venture_name": {
      "type": "string",
      "description": "Name of venture for reference"
    },
    "current_allocation": {
      "type": "object",
      "description": "Current resource allocation",
      "properties": {
        "budget": {
          "type": "number",
          "description": "Monthly budget in USD"
        },
        "headcount": {
          "type": "integer",
          "description": "Full-time equivalent headcount"
        },
        "tools_budget": {
          "type": "number",
          "description": "Tools/software budget in USD per month"
        }
      },
      "required": ["budget", "headcount"]
    },
    "recommended_allocation": {
      "type": "object",
      "description": "Recommended resource allocation",
      "properties": {
        "budget": {
          "type": "number",
          "description": "Recommended monthly budget in USD"
        },
        "headcount": {
          "type": "integer",
          "description": "Recommended full-time equivalent headcount"
        },
        "tools_budget": {
          "type": "number",
          "description": "Recommended tools/software budget in USD per month"
        }
      },
      "required": ["budget", "headcount"]
    },
    "budget_delta": {
      "type": "number",
      "description": "Change in budget (recommended - current)"
    },
    "budget_delta_pct": {
      "type": "number",
      "description": "Percentage change in budget"
    },
    "headcount_delta": {
      "type": "integer",
      "description": "Change in headcount (recommended - current)"
    },
    "rationale": {
      "type": "string",
      "description": "Explanation for allocation recommendation"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score in this allocation decision"
    },
    "effective_date": {
      "type": "string",
      "format": "date",
      "description": "Date when allocation becomes effective"
    },
    "decision_made_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of decision"
    },
    "constraints_applied": {
      "type": "array",
      "description": "List of constraints that affected this decision",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["allocation_id", "venture_id", "venture_name", "current_allocation", "recommended_allocation", "budget_delta", "headcount_delta", "rationale", "confidence", "effective_date", "decision_made_at"]
}
