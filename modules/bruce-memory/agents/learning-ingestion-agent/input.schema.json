{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Learning Ingestion Agent Input",
  "description": "Learning record from any module for ingestion into memory system",
  "required": ["learning_record"],
  "properties": {
    "learning_record": {
      "type": "object",
      "required": ["venture_id", "source_module", "outcome", "narrative"],
      "properties": {
        "venture_id": {
          "type": "string",
          "description": "Venture ID (or 'cross-venture' for portfolio-level learnings)"
        },
        "venture_name": {
          "type": "string"
        },
        "source_module": {
          "type": "string",
          "enum": ["portfolio", "governance", "risk-monitor", "allocation", "venture-team"],
          "description": "Which module is reporting this learning"
        },
        "learning_type": {
          "type": "string",
          "enum": ["hypothesis_test", "market_insight", "gtm_channel", "product_decision", "team_insight", "competitive_observation", "kill_postmortem"],
          "description": "Type of learning"
        },
        "outcome": {
          "type": "string",
          "enum": ["success", "failure", "partial_success", "inconclusive"],
          "description": "Was this learning a success or failure?"
        },
        "narrative": {
          "type": "string",
          "minLength": 50,
          "description": "Detailed narrative of the learning (what happened, why it matters)"
        },
        "quantitative_data": {
          "type": "object",
          "description": "Metrics supporting the learning",
          "properties": {
            "metric_name": {
              "type": "string"
            },
            "value": {
              "type": ["number", "string"]
            },
            "baseline": {
              "type": ["number", "string"]
            },
            "change_percent": {
              "type": "number"
            }
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Confidence in this learning (higher = more certain)"
        },
        "applicability_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags for filtering (e.g., 'B2B SaaS', 'GTM', 'pricing')"
        },
        "sector": {
          "type": "string",
          "description": "Industry vertical"
        },
        "stage": {
          "type": "string",
          "enum": ["pre-launch", "early", "growth", "mature"],
          "description": "Venture stage when learning was observed"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When this learning was observed"
        },
        "related_ventures": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other ventures with similar learning or context"
        }
      }
    }
  }
}
