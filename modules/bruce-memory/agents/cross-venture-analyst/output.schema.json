{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CrossVentureAnalystOutput",
  "type": "object",
  "required": ["analysis_id", "analysis_type", "findings"],
  "properties": {
    "analysis_id": {
      "type": "string"
    },
    "analysis_type": {
      "type": "string"
    },
    "ventures_analyzed": {
      "type": "integer"
    },
    "time_range": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "supporting_ventures", "confidence"],
        "properties": {
          "finding": {
            "type": "string",
            "description": "Clear, falsifiable pattern statement"
          },
          "supporting_ventures": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "statistical_note": {
            "type": "string"
          },
          "actionable_implication": {
            "type": "string"
          }
        }
      }
    },
    "correlations": {
      "type": "array",
      "description": "Observed correlations between variables (NOT causal claims)",
      "items": {
        "type": "object",
        "properties": {
          "variable_a": {
            "type": "string"
          },
          "variable_b": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": ["positive", "negative", "none"]
          },
          "strength": {
            "type": "string",
            "enum": ["weak", "moderate", "strong"]
          },
          "caveat": {
            "type": "string"
          }
        }
      }
    },
    "counter_intuitive_findings": {
      "type": "array",
      "description": "Findings that contradict conventional wisdom or previous assumptions",
      "items": {
        "type": "object",
        "properties": {
          "finding": {
            "type": "string"
          },
          "why_surprising": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          }
        }
      }
    },
    "insufficient_data_note": {
      "type": "string",
      "description": "Populated when data was insufficient for reliable conclusions"
    }
  }
}
