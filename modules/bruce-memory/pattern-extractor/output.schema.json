{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Pattern Extractor Output",
  "description": "Extracted patterns from learning corpus analysis",
  "required": ["pattern_extraction_result"],
  "properties": {
    "pattern_extraction_result": {
      "type": "object",
      "properties": {
        "extraction_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "learnings_analyzed": {
          "type": "integer"
        },
        "extracted_patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pattern_id": {
                "type": "string"
              },
              "statement": {
                "type": "string",
                "description": "Clear, concise pattern statement"
              },
              "pattern_type": {
                "type": "string",
                "enum": ["success_factor", "blocker", "correlation", "timing", "market_insight"],
                "description": "Type of pattern"
              },
              "evidence_ventures": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Ventures exhibiting this pattern"
              },
              "evidence_count": {
                "type": "integer"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "effect_size": {
                "type": "string",
                "enum": ["small", "medium", "large"],
                "description": "Magnitude of pattern impact"
              },
              "applicability_scope": {
                "type": "object",
                "properties": {
                  "sectors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "stages": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "geographies": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "caveats": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Conditions and limitations"
              },
              "supporting_evidence": {
                "type": "string",
                "description": "Summary of supporting learnings"
              },
              "counter_examples": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Exceptions to this pattern"
              }
            }
          }
        },
        "pattern_retirement_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pattern_id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          },
          "description": "Patterns that may be outdated"
        },
        "emerging_patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pattern_statement": {
                "type": "string"
              },
              "evidence_count": {
                "type": "integer"
              },
              "confidence": {
                "type": "number"
              },
              "reason_not_published": {
                "type": "string"
              }
            }
          },
          "description": "Potential patterns not yet meeting publication threshold"
        }
      }
    }
  }
}
