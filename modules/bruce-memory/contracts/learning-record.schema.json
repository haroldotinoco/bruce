{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bruce-memory/contracts/learning-record",
  "title": "LearningRecord",
  "description": "A single learning extracted from a venture event or outcome",
  "type": "object",
  "required": [
    "learning_id",
    "source_module",
    "venture_id",
    "learning_narrative",
    "confidence",
    "created_at"
  ],
  "properties": {
    "learning_id": {
      "type": "string"
    },
    "source_module": {
      "type": "string",
      "enum": [
        "opportunity",
        "add-venture",
        "brand-aid",
        "builder",
        "gtm",
        "startup-ops",
        "portfolio",
        "bruce-core"
      ]
    },
    "venture_id": {
      "type": "string"
    },
    "venture_name": {
      "type": "string"
    },
    "venture_stage_at_time": {
      "type": "string",
      "enum": [
        "structured",
        "built",
        "launched",
        "operating",
        "iterating",
        "scaling",
        "paused",
        "killed"
      ]
    },
    "market_segment": {
      "type": "string"
    },
    "business_model_type": {
      "type": "string"
    },
    "learning_narrative": {
      "type": "string",
      "description": "Clear, plain-language description of what was learned",
      "minLength": 50
    },
    "quantitative_data": {
      "type": "object",
      "description": "At least one measurable data point supporting the learning"
    },
    "venture_outcome": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "ongoing"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Domain tags: e.g. gtm, unit-economics, product, market-timing"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Submitter confidence in this learning (0.4 minimum to store)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_event_id": {
      "type": "string"
    },
    "embedding_ref": {
      "type": "string",
      "description": "Vector DB reference after embedding"
    }
  }
}
