{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Visual System Designer Input",
  "type": "object",
  "required": ["creative_direction", "brand_archetype"],
  "properties": {
    "creative_direction": {
      "type": "object",
      "properties": {
        "mood_board_description": { "type": "string" },
        "visual_language_criteria": { "type": "array", "items": { "type": "string" } },
        "design_token_guidance": { "type": "object" }
      }
    },
    "brand_archetype": {
      "type": "string",
      "description": "Primary brand archetype"
    },
    "implementation_context": {
      "type": "object",
      "properties": {
        "primary_medium": { "type": "string", "enum": ["web", "mobile", "print", "multi-channel"] },
        "color_model_preference": { "type": "string", "enum": ["RGB", "HSL", "HEX"] },
        "design_tool": { "type": "string", "enum": ["Figma", "Sketch", "XD", "agnostic"] }
      }
    },
    "accessibility_requirements": {
      "type": "object",
      "properties": {
        "wcag_level": { "type": "string", "enum": ["A", "AA", "AAA"] },
        "color_blindness_safe": { "type": "boolean" }
      },
      "default": { "wcag_level": "AA", "color_blindness_safe": true }
    },
    "constraint_colors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Any colors that must be included or excluded"
    }
  }
}
