{
  "name": "security-agent",
  "purpose": "Performs security audit of the built application — checks OWASP Top 10, authentication implementation, secrets exposure, dependency vulnerabilities",
  "input_types": [
    "code_repo_ref",
    "deployed_staging_url",
    "api_contracts"
  ],
  "output_types": [
    "security_report",
    "vulnerability_list",
    "compliance_assessment"
  ],
  "external_dependencies": [],
  "stateful": false,
  "runtime": {
    "provider": "openrouter",
    "model": null,
    "api_key_ref": "OPENROUTER_API_KEY",
    "temperature": 0.1,
    "max_tokens": 8192,
    "fallback_provider": null,
    "fallback_model": null
  }
}
