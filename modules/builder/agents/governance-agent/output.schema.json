{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Governance Agent Output",
  "type": "object",
  "required": ["launch_approved", "approval_rationale", "launch_readiness_score"],
  "properties": {
    "launch_approved": {
      "type": "boolean",
      "description": "Final launch approval decision"
    },
    "approval_rationale": {
      "type": "string",
      "description": "Detailed explanation of approval or blocking decision"
    },
    "blocking_issues": {
      "type": "array",
      "description": "Issues preventing launch approval",
      "items": {
        "type": "object",
        "properties": {
          "stage": { "type": "string" },
          "issue": { "type": "string" },
          "severity": { "type": "string" },
          "remediation": { "type": "string" }
        }
      }
    },
    "launch_readiness_score": {
      "type": "number",
      "description": "Overall readiness percentage (0-100)"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Approval timestamp"
    },
    "approved_by": {
      "type": "string",
      "description": "Role/system approving launch"
    },
    "conditions": {
      "type": "array",
      "description": "Post-launch monitoring and operational requirements",
      "items": {
        "type": "object",
        "properties": {
          "condition_id": { "type": "string" },
          "description": { "type": "string" },
          "enforcement": { "type": "string" }
        }
      }
    },
    "stage_summary": {
      "type": "object",
      "description": "Summary of all stage results",
      "properties": {
        "functional_validation": { "type": "string" },
        "ux_bdd_specification": { "type": "string" },
        "solution_architecture": { "type": "string" },
        "backend_development": { "type": "string" },
        "frontend_development": { "type": "string" },
        "qa_testing": { "type": "string" },
        "security_audit": { "type": "string" }
      }
    }
  }
}
