{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Functional Specification",
  "type": "object",
  "required": ["feature_list", "user_flows", "buildability_assessment"],
  "properties": {
    "feature_list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "priority": { "type": "string" },
          "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "user_flows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "flow_name": { "type": "string" },
          "actors": { "type": "array", "items": { "type": "string" } },
          "steps": { "type": "array", "items": { "type": "string" } },
          "happy_path": { "type": "string" },
          "edge_cases": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "data_model_overview": {
      "type": "object",
      "properties": {
        "entities": { "type": "array", "items": { "type": "string" } },
        "relationships": { "type": "string" },
        "key_fields": { "type": "object" }
      }
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service": { "type": "string" },
          "purpose": { "type": "string" },
          "criticality": { "type": "string", "enum": ["critical", "high", "medium", "low"] }
        }
      }
    },
    "assumptions_and_constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "buildability_assessment": {
      "type": "object",
      "properties": {
        "feasible": { "type": "boolean" },
        "concerns": { "type": "array", "items": { "type": "string" } },
        "scope_evaluation": { "type": "string" },
        "recommendations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "pass_fail": {
      "type": "boolean",
      "description": "Can this proceed to design/architecture phases?"
    }
  }
}
