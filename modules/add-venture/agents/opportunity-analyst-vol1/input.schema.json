{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Opportunity Analyst Vol 1 Input",
  "type": "object",
  "properties": {
    "briefing": {
      "type": "object",
      "properties": {
        "venture_id": {"type": "string"},
        "opportunity_id": {"type": "string"},
        "problem_context": {"type": "object"},
        "market_context": {"type": "object"},
        "customer_context": {"type": "object"},
        "competitive_context": {"type": "object"},
        "key_assumptions": {"type": "array", "items": {"type": "string"}},
        "data_gaps": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["venture_id", "opportunity_id", "problem_context", "market_context", "customer_context"]
    },
    "analysis_parameters": {
      "type": "object",
      "properties": {
        "depth_level": {
          "type": "string",
          "enum": ["executive_summary", "standard", "deep_dive"],
          "default": "standard"
        },
        "market_validation_focus": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Specific market aspects to emphasize"
        }
      }
    }
  },
  "required": ["briefing"]
}
