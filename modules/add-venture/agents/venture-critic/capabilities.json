{
  "name": "venture-critic",
  "purpose": "Review complete 8-volume dossier and produce quality score with specific feedback. Act as rigorous devil's advocate.",
  "input_types": [
    "volume_1_opportunity",
    "volume_2_customer_market",
    "volume_3_value_proposition",
    "volume_4_business_model",
    "volume_5_gtm",
    "volume_6_narrative",
    "volume_7_risk_validation",
    "volume_8_execution_roadmap"
  ],
  "output_types": [
    "critique_result"
  ],
  "external_dependencies": [],
  "stateful": false,
  "runtime": {
    "provider": "openrouter",
    "model": null,
    "api_key_ref": "OPENROUTER_API_KEY",
    "temperature": 0.2,
    "max_tokens": 6144,
    "fallback_provider": null,
    "fallback_model": null
  },
  "performance_targets": {
    "average_execution_time_seconds": 150,
    "content_depth_target": 2000,
    "confidence_calibration_threshold": 0.9
  },
  "cost_estimation": {
    "avg_cost_per_volume_usd": 0.15,
    "max_cost_per_volume_usd": 0.3
  }
}
