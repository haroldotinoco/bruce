  },
  "performance_targets": {
    "average_execution_time_seconds": 180,
    "content_depth_target": 2250,
    "confidence_calibration_threshold": 0.8
  },
  "cost_estimation": {
    "avg_cost_per_volume_usd": 0.35,
    "max_cost_per_volume_usd": 0.75
  }
}
