{
  "name": "dossier-composer",
  "purpose": "Assemble all 8 volumes + critique metadata into final structured venture dossier artifact",
  "input_types": [
    "volume_1_opportunity",
    "volume_2_customer_market",
    "volume_3_value_proposition",
    "volume_4_business_model",
    "volume_5_gtm",
    "volume_6_narrative",
    "volume_7_risk_validation",
    "volume_8_execution_roadmap",
    "critique_result"
  ],
  "output_types": [
    "final_venture_dossier"
  ],
  "external_dependencies": [],
  "stateful": false,
  "runtime": {
    "provider": "openrouter",
    "model": null,
    "api_key_ref": "OPENROUTER_API_KEY",
    "temperature": 0.1,
    "max_tokens": 8192,
    "fallback_provider": null,
    "fallback_model": null
  },
  "performance_targets": {
    "average_execution_time_seconds": 60,
    "content_depth_target": 1000,
    "confidence_calibration_threshold": 0.95
  },
  "cost_estimation": {
    "avg_cost_per_volume_usd": 0.08,
    "max_cost_per_volume_usd": 0.15
  }
}
