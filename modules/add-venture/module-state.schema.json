{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AddVenture Module State",
  "type": "object",
  "properties": {
    "module_id": {
      "type": "string",
      "default": "add-venture"
    },
    "active_structuring_jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "venture_id": {"type": "string"},
          "opportunity_id": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["started", "in_progress", "completed", "failed"]
          },
          "started_date": {"type": "string", "format": "date-time"},
          "current_volume": {"type": "integer"},
          "current_iteration": {"type": "integer"}
        }
      }
    },
    "completed_dossiers": {
      "type": "array",
      "items": {"type": "string"},
      "description": "IDs of completed venture dossiers"
    },
    "dossier_count": {
      "type": "integer",
      "default": 0
    },
    "statistics": {
      "type": "object",
      "properties": {
        "avg_iterations_per_venture": {"type": "number"},
        "avg_dossier_score": {"type": "number"},
        "pass_rate": {"type": "number"}
      }
    }
  },
  "required": ["module_id"]
}
