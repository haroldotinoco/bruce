{
  "workflow_id": "venture-structuring-pipeline",
  "workflow_name": "Venture Structuring Pipeline",
  "description": "Complete sequential 8-volume pipeline with critique loop and conditional branching",
  "version": "1.0",
  "created_date": "2026-04-06",
  "steps": [
    {
      "step_id": "briefing-interpretation",
      "step_name": "Briefing Interpretation",
      "agent": "briefing-interpreter",
      "input_from": "external",
      "output_to": "volume_1",
      "timeout_seconds": 300,
      "retry_policy": {"max_retries": 2, "backoff_seconds": 60},
      "failure_policy": "escalate",
      "next_step": "volume_1",
      "events_emitted": ["briefing.interpreted", "briefing.quality_gated"]
    },
    {
      "step_id": "volume_1",
      "step_name": "Opportunity Diagnosis (Vol 1)",
      "agent": "opportunity-analyst-vol1",
      "input_from": "briefing-interpretation",
      "output_to": "volumes_2_8_parallel",
      "timeout_seconds": 300,
      "retry_policy": {"max_retries": 1, "backoff_seconds": 60},
      "failure_policy": "escalate",
      "next_step": "volumes_2_8_parallel",
      "events_emitted": ["volume.1.completed"]
    },
    {
      "step_id": "volumes_2_8_parallel",
      "step_name": "Parallel Volumes 2-8",
      "agent": "none",
      "input_from": "volume_1",
      "output_to": "critique-evaluation",
      "timeout_seconds": 600,
      "retry_policy": {"max_retries": 0},
      "failure_policy": "fail_one_retry_all",
      "parallel_steps": [
        {
          "step_id": "volume_2",
          "agent": "customer-market-architect",
          "timeout_seconds": 300,
          "events_emitted": ["volume.2.completed"]
        },
        {
          "step_id": "volume_3",
          "agent": "value-proposition-designer",
          "timeout_seconds": 300,
          "events_emitted": ["volume.3.completed"]
        },
        {
          "step_id": "volume_4",
          "agent": "business-model-modeler",
          "timeout_seconds": 600,
          "events_emitted": ["volume.4.completed"]
        },
        {
          "step_id": "volume_5",
          "agent": "gtm-planner",
          "timeout_seconds": 300,
          "events_emitted": ["volume.5.completed"]
        },
        {
          "step_id": "volume_6",
          "agent": "narrative-strategist",
          "timeout_seconds": 300,
          "events_emitted": ["volume.6.completed"]
        },
        {
          "step_id": "volume_7",
          "agent": "risk-validation-analyst",
          "timeout_seconds": 600,
          "events_emitted": ["volume.7.completed"]
        },
        {
          "step_id": "volume_8",
          "agent": "execution-roadmap-planner",
          "timeout_seconds": 300,
          "events_emitted": ["volume.8.completed"]
        }
      ],
      "next_step": "critique-evaluation"
    },
    {
      "step_id": "critique-evaluation",
      "step_name": "Dossier Critique Review",
      "agent": "venture-critic",
      "input_from": "volumes_2_8_parallel",
      "output_to": "conditional_branching",
      "timeout_seconds": 300,
      "retry_policy": {"max_retries": 0},
      "failure_policy": "escalate",
      "conditional_next_steps": {
        "score_70_or_higher": {
          "condition": "critique.overall_score >= 70",
          "next_step": "dossier-composition",
          "events_emitted": ["critique.scored", "critique.passed"]
        },
        "score_60_to_69": {
          "condition": "critique.overall_score >= 60 AND critique.overall_score < 70 AND iteration_count < 3",
          "next_step": "volume-iteration",
          "events_emitted": ["critique.scored", "critique.iteration.triggered"]
        },
        "score_below_60_or_max_iterations": {
          "condition": "critique.overall_score < 60 OR iteration_count >= 3",
          "next_step": "escalate-human",
          "events_emitted": ["critique.scored", "critique.rejection.triggered"]
        }
      }
    },
    {
      "step_id": "volume-iteration",
      "step_name": "Iterate Weak Volumes",
      "agent": "none",
      "input_from": "critique-evaluation",
      "output_to": "critique-evaluation",
      "timeout_seconds": 300,
      "retry_policy": {"max_retries": 0},
      "failure_policy": "escalate",
      "iteration_step": true,
      "re_runs_weak_volumes": true,
      "events_emitted": ["volume.iteration.started"],
      "next_step": "critique-evaluation"
    },
    {
      "step_id": "dossier-composition",
      "step_name": "Final Dossier Assembly",
      "agent": "dossier-composer",
      "input_from": "critique-evaluation",
      "output_to": "emit-to-bruce-core",
      "timeout_seconds": 180,
      "retry_policy": {"max_retries": 1},
      "failure_policy": "escalate",
      "next_step": "emit-to-bruce-core",
      "events_emitted": ["dossier.composed"]
    },
    {
      "step_id": "emit-to-bruce-core",
      "step_name": "Emit to BruceCore",
      "agent": "none",
      "input_from": "dossier-composition",
      "output_to": "external",
      "timeout_seconds": 60,
      "retry_policy": {"max_retries": 1},
      "failure_policy": "fail",
      "next_step": "none",
      "events_emitted": ["dossier.completed", "venture.structuring.completed"]
    },
    {
      "step_id": "escalate-human",
      "step_name": "Escalate to Portfolio Leadership",
      "agent": "none",
      "input_from": "critique-evaluation",
      "output_to": "external",
      "timeout_seconds": 3600,
      "failure_policy": "escalate",
      "next_step": "none",
      "events_emitted": ["dossier.escalated"]
    }
  ],
  "state_management": {
    "track_venture_id": true,
    "track_iteration_count": true,
    "track_current_phase": true,
    "preserve_volumes_across_iterations": true
  },
  "error_handling": {
    "timeout_exceeded": "escalate to human + log for analysis",
    "agent_error": "retry up to max_retries, then escalate",
    "inconsistent_state": "halt and escalate"
  }
}
