{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bruceai.dev/schemas/venture-to-brand.schema.json",
  "title": "Venture to Brand Handoff",
  "description": "Handoff from add-venture module to brand-aid module. Encapsulates hypothesis, target audience, and positioning to enable brand strategy and visual identity creation.",
  "type": "object",
  "properties": {
    "venture_id": {
      "type": "string",
      "description": "Venture identifier (UUID v4)"
    },
    "value_proposition": {
      "type": "string",
      "description": "Core value proposition - what unique benefit is delivered to customer?"
    },
    "target_audience": {
      "type": "object",
      "description": "Detailed target audience definition",
      "properties": {
        "primary_segment": {
          "type": "string",
          "description": "Primary customer segment name"
        },
        "demographics": {
          "type": "array",
          "description": "Demographic characteristics (e.g., 'Age 25-45', 'Tech workers', 'High income')",
          "items": {
            "type": "string"
          }
        },
        "psychographics": {
          "type": "array",
          "description": "Psychographic traits (e.g., 'Early adopters', 'Values efficiency', 'Quality-conscious')",
          "items": {
            "type": "string"
          }
        },
        "pain_points": {
          "type": "array",
          "description": "Specific problems they face",
          "items": {
            "type": "string"
          }
        },
        "aspirations": {
          "type": "array",
          "description": "What do they want to achieve?",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["primary_segment"]
    },
    "positioning_statement": {
      "type": "string",
      "description": "How should brand be positioned vs. competitors? (1-2 sentences)"
    },
    "positioning_pillars": {
      "type": "array",
      "description": "Key positioning pillars (e.g., 'Simplicity', 'Speed', 'Trust')",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "maxItems": 4
    },
    "tone_of_voice": {
      "type": "array",
      "description": "Brand voice descriptors (e.g., 'friendly', 'authoritative', 'playful', 'professional')",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "maxItems": 5
    },
    "visual_mood": {
      "type": "array",
      "description": "Visual identity mood (e.g., 'modern', 'minimal', 'vibrant', 'corporate', 'creative')",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "maxItems": 5
    },
    "competitive_differentiation": {
      "type": "string",
      "description": "What makes this brand different from competitors?"
    },
    "brand_archetypes": {
      "type": "array",
      "description": "Brand archetypes (e.g., 'The Innovator', 'The Sage', 'The Caregiver', 'The Creator')",
      "items": {
        "type": "string"
      }
    },
    "brand_story": {
      "type": "string",
      "description": "Origin story or brand narrative"
    },
    "mission_statement": {
      "type": "string",
      "description": "What is the higher purpose?"
    },
    "core_values": {
      "type": "array",
      "description": "Core company values",
      "items": {
        "type": "string"
      }
    },
    "brand_name_suggestions": {
      "type": "array",
      "description": "Suggested brand names (if not yet finalized)",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "availability_check": {
            "type": "boolean",
            "description": "Has domain/trademark availability been checked?"
          }
        }
      }
    },
    "competitive_set": {
      "type": "array",
      "description": "Direct and indirect competitors for brand differentiation",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "positioning": {
            "type": "string"
          },
          "differentiation_opportunity": {
            "type": "string"
          }
        }
      }
    },
    "visual_direction_preferences": {
      "type": "object",
      "description": "Guidance for visual identity",
      "properties": {
        "style_references": {
          "type": "array",
          "description": "Example brands or design styles to reference",
          "items": {
            "type": "string"
          }
        },
        "color_temperature": {
          "type": "string",
          "enum": ["cool", "warm", "neutral"],
          "description": "Color temperature preference"
        },
        "geometric_vs_organic": {
          "type": "string",
          "enum": ["geometric", "organic", "mixed"],
          "description": "Shape preference"
        },
        "minimal_vs_detailed": {
          "type": "string",
          "enum": ["minimal", "detailed", "balanced"],
          "description": "Detail level"
        }
      }
    },
    "messaging_pillars": {
      "type": "array",
      "description": "Key messages to communicate",
      "items": {
        "type": "object",
        "properties": {
          "pillar": {
            "type": "string"
          },
          "supporting_messages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "venture_id",
    "value_proposition",
    "target_audience",
    "positioning_statement",
    "tone_of_voice",
    "visual_mood"
  ],
  "additionalProperties": false
}
