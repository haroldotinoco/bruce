{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpsRecommendation",
  "description": "Actionable operational recommendation with urgency and expected impact",
  "type": "object",
  "required": ["recommendation_id", "venture_id", "created_at", "area", "title", "urgency", "specific_actions"],
  "properties": {
    "recommendation_id": { "type": "string" },
    "venture_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "area": {
      "type": "string",
      "enum": ["activation", "retention", "revenue", "product_quality", "financial_sustainability", "market_fit", "general"]
    },
    "title": { "type": "string", "minLength": 5, "maxLength": 100 },
    "description": { "type": "string" },
    "urgency": { "type": "string", "enum": ["immediate", "this_week", "next_cycle"] },
    "expected_impact": { "type": "string" },
    "specific_actions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "metrics_to_watch": { "type": "array", "items": { "type": "string" } },
    "created_from_anomaly_id": { "type": ["string", "null"] }
  }
}
