{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Anomaly",
  "description": "Detected anomaly with severity and recommendation",
  "type": "object",
  "required": ["anomaly_id", "venture_id", "detected_at", "type", "metric_name", "severity", "current_value", "baseline_value", "delta_percent", "description", "recommendation", "requires_escalation"],
  "properties": {
    "anomaly_id": { "type": "string" },
    "venture_id": { "type": "string" },
    "detected_at": { "type": "string", "format": "date-time" },
    "type": {
      "type": "string",
      "enum": ["sudden_drop", "concerning_trend", "positive_breakout", "sustained_decline"]
    },
    "metric_name": { "type": "string" },
    "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
    "current_value": { "type": ["number", "null"] },
    "baseline_value": { "type": ["number", "null"] },
    "delta_percent": { "type": "number" },
    "z_score": { "type": ["number", "null"] },
    "description": { "type": "string" },
    "recommendation": { "type": "string" },
    "requires_escalation": { "type": "boolean" }
  }
}
