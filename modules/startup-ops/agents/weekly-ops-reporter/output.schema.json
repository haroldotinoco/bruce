{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WeeklyReporterOutput",
  "type": "object",
  "required": ["report_id", "venture_id", "period", "executive_summary", "metric_table"],
  "properties": {
    "report_id": {
      "type": "string",
      "description": "Unique identifier for this weekly report"
    },
    "venture_id": {
      "type": "string",
      "description": "Venture this report covers"
    },
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      },
      "description": "Week covered by this report (Monday-Sunday)"
    },
    "executive_summary": {
      "type": "string",
      "minLength": 200,
      "maxLength": 1000,
      "description": "3-5 sentence summary of venture operational status and key changes"
    },
    "health_score_delta_vs_last_week": {
      "type": "number",
      "nullable": true,
      "description": "Change in composite health score from previous week"
    },
    "highlights": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "maxItems": 4,
      "description": "2-4 positive signals or achievements from the week"
    },
    "concerns": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 0,
      "maxItems": 4,
      "description": "2-4 areas of concern requiring attention"
    },
    "metric_table": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": { "type": "number", "nullable": true },
          "previous_value": { "type": "number", "nullable": true },
          "change_percent": { "type": "number", "nullable": true },
          "status": { "type": "string", "enum": ["up", "down", "stable"] }
        }
      },
      "description": "Top 15 KPIs with current values and week-over-week change"
    },
    "anomalies_summary": {
      "type": "string",
      "nullable": true,
      "description": "Narrative summary of detected anomalies and required actions"
    },
    "recommendations_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "urgency": { "type": "string", "enum": ["immediate", "this_week", "next_cycle"] },
          "action": { "type": "string" }
        }
      },
      "description": "Condensed version of key recommendations"
    },
    "next_week_focus": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "maxItems": 3,
      "description": "1-3 specific priorities for next week"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this report was generated"
    },
    "report_artifact_ref": {
      "type": "string",
      "nullable": true,
      "description": "Optional reference to full report storage location"
    }
  }
}
