{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpsAdvisorOutput",
  "type": "object",
  "required": ["venture_id", "created_at", "recommendations", "overall_action_required", "risk_summary"],
  "properties": {
    "venture_id": {
      "type": "string",
      "description": "Venture these recommendations are for"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When recommendations were generated"
    },
    "recommendations": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["recommendation_id", "area", "title", "urgency", "specific_actions"],
        "properties": {
          "recommendation_id": {
            "type": "string",
            "description": "Unique identifier for this recommendation"
          },
          "area": {
            "type": "string",
            "enum": ["activation", "retention", "revenue", "product_quality", "financial_sustainability", "market_fit", "general"],
            "description": "Operational area this recommendation addresses"
          },
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 100,
            "description": "Short, actionable title"
          },
          "description": {
            "type": "string",
            "description": "Detailed explanation of why this action matters"
          },
          "urgency": {
            "type": "string",
            "enum": ["immediate", "this_week", "next_cycle"],
            "description": "Timeline for execution"
          },
          "expected_impact": {
            "type": "string",
            "description": "Estimated business outcome if recommendation is executed"
          },
          "specific_actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": { "type": "string" },
            "description": "Concrete, executable action items"
          },
          "metrics_to_watch": {
            "type": "array",
            "items": { "type": "string" },
            "description": "KPIs to monitor for success"
          },
          "created_from_anomaly_id": {
            "type": "string",
            "nullable": true,
            "description": "Reference to anomaly that triggered this recommendation"
          }
        }
      },
      "description": "Prioritized list of recommendations (max 5)"
    },
    "risk_summary": {
      "type": "string",
      "description": "Executive summary of current operational risks and opportunities"
    },
    "overall_action_required": {
      "type": "boolean",
      "description": "Whether immediate action is required to address health or anomalies"
    },
    "health_report_id": {
      "type": "string",
      "description": "Reference to health report analyzed"
    }
  }
}
