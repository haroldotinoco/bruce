{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnomalyDetectionInput",
  "type": "object",
  "required": ["current_snapshot", "last_4_snapshots", "health_scores"],
  "properties": {
    "current_snapshot": {
      "type": "object",
      "required": ["snapshot_id", "metrics"],
      "properties": {
        "snapshot_id": { "type": "string" },
        "venture_id": { "type": "string" },
        "collected_at": { "type": "string", "format": "date-time" },
        "metrics": { "type": "object" }
      }
    },
    "last_4_snapshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "snapshot_id": { "type": "string" },
          "collected_at": { "type": "string", "format": "date-time" },
          "metrics": { "type": "object" }
        }
      },
      "description": "Previous 4 metric snapshots for baseline calculation and trend analysis"
    },
    "health_scores": {
      "type": "object",
      "properties": {
        "composite_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "dimension_scores": { "type": "object" }
      },
      "description": "Current health scores for severity context"
    },
    "venture_context": {
      "type": "object",
      "properties": {
        "stage": { "type": "string", "enum": ["seed", "early", "growth"] },
        "known_events": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Known external events (e.g., 'major_customer_churn', 'paid_campaign_launch')"
        }
      }
    }
  }
}
