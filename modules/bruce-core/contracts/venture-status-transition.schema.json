{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Venture Status Transition Contract",
  "description": "Contract for venture state transitions published on event bus",
  "type": "object",
  "required": ["event_type", "venture_id", "previous_stage", "new_stage"],
  "properties": {
    "event_type": {
      "type": "string",
      "const": "venture.stage_transitioned",
      "description": "Event type constant"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt-[a-z0-9]{8}$"
    },
    "venture_id": {
      "type": "string",
      "pattern": "^v-[a-z0-9]{8}$"
    },
    "previous_stage": {
      "type": "string",
      "enum": ["GENERATED", "QUALIFIED", "STRUCTURED", "BUILT", "LAUNCHED", "OPERATING", "ITERATING", "SCALING", "PAUSED", "KILLED"]
    },
    "new_stage": {
      "type": "string",
      "enum": ["GENERATED", "QUALIFIED", "STRUCTURED", "BUILT", "LAUNCHED", "OPERATING", "ITERATING", "SCALING", "PAUSED", "KILLED"]
    },
    "trigger": {
      "type": "string",
      "enum": ["gate_passed", "governance_decision", "manual_override"],
      "description": "What caused the transition"
    },
    "gate_decision_id": {
      "type": "string",
      "description": "If triggered by gate, reference to gate decision"
    },
    "portfolio_decision_id": {
      "type": "string",
      "description": "If triggered by governance, reference to governance decision"
    },
    "transition_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string"
    }
  }
}
