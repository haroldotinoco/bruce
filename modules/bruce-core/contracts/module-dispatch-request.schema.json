{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Module Dispatch Request Contract",
  "description": "Contract for dispatch requests from Lifecycle Manager to Dispatcher",
  "type": "object",
  "required": ["venture_id", "stage", "modules"],
  "properties": {
    "dispatch_batch_id": {
      "type": "string",
      "pattern": "^batch-disp-[a-z0-9]{6}$",
      "description": "Batch identifier for this dispatch (generated by Dispatcher)"
    },
    "venture_id": {
      "type": "string",
      "pattern": "^v-[a-z0-9]{8}$"
    },
    "stage": {
      "type": "string",
      "enum": ["GENERATED", "QUALIFIED", "STRUCTURED", "BUILT", "LAUNCHED", "OPERATING"],
      "description": "Venture stage triggering dispatch"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["opportunity_screening", "brand", "builder", "market", "operator", "portfolio"]
      },
      "description": "Modules to invoke"
    },
    "venture_context": {
      "type": "object",
      "description": "Venture record to pass to modules"
    },
    "module_inputs": {
      "type": "object",
      "description": "Specific inputs for each module (e.g., prior outputs)",
      "additionalProperties": {
        "type": "object"
      }
    },
    "trigger_type": {
      "type": "string",
      "enum": ["stage_advancement", "retry"],
      "description": "What triggered this dispatch"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "timeout_per_module_seconds": {
      "type": "number",
      "description": "Execution timeout for each module"
    }
  }
}
