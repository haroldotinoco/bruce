{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Governance Agent Input",
  "description": "Input to Governance Agent for portfolio-level decision making",
  "type": "object",
  "required": ["venture_id", "portfolio_health_report"],
  "properties": {
    "venture_id": {
      "type": "string",
      "pattern": "^v-[a-z0-9]{8}$"
    },
    "decision_request_type": {
      "type": "string",
      "enum": ["periodic_review", "gate_failure_response", "manual_request"],
      "description": "Type of governance decision request"
    },
    "portfolio_health_report": {
      "type": "object",
      "description": "Health analysis from Portfolio module",
      "properties": {
        "venture_id": { "type": "string" },
        "current_stage": { "type": "string" },
        "health_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "growth_metrics": {
          "type": "object",
          "properties": {
            "wow_growth_pct": { "type": "number" },
            "mom_growth_pct": { "type": "number" }
          }
        },
        "unit_economics": {
          "type": "object",
          "properties": {
            "cac": { "type": "number" },
            "ltv": { "type": "number" },
            "cac_ltv_ratio": { "type": "number" },
            "gross_margin_pct": { "type": "number" },
            "cac_payback_months": { "type": "number" }
          }
        },
        "product_market_fit": {
          "type": "object",
          "properties": {
            "month_1_retention": { "type": "number", "minimum": 0, "maximum": 1 },
            "month_2_retention": { "type": "number", "minimum": 0, "maximum": 1 },
            "nps": { "type": "number", "minimum": -100, "maximum": 100 }
          }
        },
        "operational_health": {
          "type": "object",
          "properties": {
            "burn_rate_monthly": { "type": "number" },
            "runway_months": { "type": "number" },
            "team_size": { "type": "number" },
            "key_open_roles": { "type": "array", "items": { "type": "string" } }
          }
        },
        "identified_risks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "risk": { "type": "string" },
              "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
              "identified_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "venture_context": {
      "type": "object",
      "properties": {
        "venture_id": { "type": "string" },
        "name": { "type": "string" },
        "founder_info": { "type": "object" },
        "stage": { "type": "string" },
        "launched_date": { "type": "string", "format": "date-time" }
      }
    },
    "portfolio_context": {
      "type": "object",
      "description": "Portfolio composition and constraints",
      "properties": {
        "total_active_ventures": { "type": "number" },
        "ventures_by_stage": { "type": "object" },
        "total_monthly_burn": { "type": "number" },
        "total_runway_months": { "type": "number" },
        "resource_constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "prior_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision": { "type": "string" },
          "decided_at": { "type": "string", "format": "date-time" },
          "confidence_score": { "type": "number" }
        }
      },
      "description": "Prior governance decisions for this venture (for consistency check)"
    },
    "correlation_id": {
      "type": "string"
    }
  }
}
