# =============================================================================
# BruceAI — exemplo completo de variáveis de ambiente
# Copie para `.env` e preencha. Nunca commite `.env`.
# Referência: `docker-compose.yml` (raiz), `packages/*`, `apps/*`.
# =============================================================================

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
# Nível do Pino no console (e streams @bruce/logger). Valores: trace | debug | info | warn | error | fatal.
# Use `info` no dia-a-dia local; `debug` quando precisar de HTTP por pedido, agent steps, etc.
LOG_LEVEL=info
# Os apps e workers carregam este ficheiro automaticamente via @bruce/env (raiz do monorepo),
# mesmo quando corres `pnpm --filter ... run worker` a partir de apps/* — não precisas de `source .env`.

# ── HTTP / CORS ─────────────────────────────────────────────────────────────
# PORT é lido por cada processo Node (bruce-core usa 3000 por defeito; opportunity 3002).
# Com `pnpm dev` (Turborepo), defina PORT por pacote via script ou ficheiro `.env` por app.
PORT=3000
CORS_ORIGIN=http://localhost:3000
# URL pública da API (OpenAPI / redirects). Ajuste por serviço se correr vários HTTP em paralelo.
API_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Local (compose na raiz): user bruce, DB bruce_dev, password bruce_dev_password
DATABASE_URL=postgresql://bruce:bruce_dev_password@localhost:5432/bruce_dev

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Temporal ──────────────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Nível de log do SDK TypeScript do Temporal no worker: TRACE | DEBUG | INFO | WARN | ERROR.
TEMPORAL_LOG_LEVEL=WARN
# Temporal Cloud (opcional)
# TEMPORAL_TLS_CERT=
# TEMPORAL_TLS_KEY=

# ── Qdrant (vector) ───────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Object storage (@bruce/storage) — MinIO local ou S3/R2 ───────────────────
STORAGE_BUCKET=bruce
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Aliases Cloudflare R2 (legado / docs em modules/) — mapeie para o mesmo que STORAGE_*
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=bruceai-artifacts
# R2_PUBLIC_URL=
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=bruceai-artifacts
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# ── LLM (@bruce/llm) ─────────────────────────────────────────────────────────
# Caminho opcional para `bruce-model-registry.json` (aliases de modelo, defaults, pools).
# Por defeito procura-se o ficheiro na raiz do monorepo subindo a partir do cwd.
# BRUCE_MODEL_REGISTRY_PATH=/absolute/path/to/bruce-model-registry.json
# Modo global por defeito no LLMClient genérico. Cada agente define o seu em
# modules/<módulo>/agents/<agente>/capabilities.json → runtime.provider + runtime.model
# (ex.: openrouter + openai/gpt-4o). OPENROUTER_API_KEY é usado quando provider=openrouter.
LLM_PROVIDER_MODE=openrouter

# Fallback quando um agente não define `runtime.model` no capabilities.json,
# ou quando o LLMClient é construído sem modelo. Ordem de resolução:
#   1. DEFAULT_FALLBACK_AGENT_MODEL (esta env)
#   2. bruce-model-registry.json → defaults.default_model
#   3. literal embutido (openai/gpt-oss-120b:free)
# Use slug completo do OpenRouter (provedor/modelo[:variant]).
# DEFAULT_FALLBACK_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Chaves diretas (só se algum agente usar provider openai ou anthropic nesse JSON)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OpenRouter (IDs com prefixo; vê https://openrouter.ai/models — slugs mudam; ex.: openai/gpt-4o)
# Used for LLM calls; optional but recommended for `pnpm --filter @bruce/db run sync:openrouter-models` (and restart-dev-stack).
OPENROUTER_API_KEY=

# ── Auth — Clerk ────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
# JWT do script print-dev-jwt.mjs não passa em verifyToken do Clerk. Com CLERK_SECRET_KEY preenchido,
# descomenta para desenvolvimento local OU deixa CLERK_SECRET_KEY vazio.
# AUTH_DEV_JWT_ONLY=true

# ── JWT entre módulos (@bruce/auth) ──────────────────────────────────────────
INTER_MODULE_JWT_SECRET=change-me-in-production-use-at-least-32-characters
# TTL usado em código ao assinar (segundos); não é variável de ambiente no pacote atual

# ── Stripe / billing (@bruce/stripe-client, rotas bruce-core) ───────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_FREE=
STRIPE_PRODUCT_PRO=
STRIPE_PRODUCT_ENTERPRISE=
# STRIPE_METER_EVENT_ENDPOINT=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# ── Observabilidade ───────────────────────────────────────────────────────────
BETTERSTACK_SOURCE_TOKEN=

# ── Event bus (@bruce/events) ────────────────────────────────────────────────
# Omitir ou `memory` = bus em memória no processo atual (default de código).
# Para desenvolvimento multi-processo e handoffs reais entre módulos, use `redis`
# com REDIS_URL e workers BullMQ explícitos. Ver docs/operator-golden-path.md.
BRUCE_EVENT_BUS=redis

# ── Workers (apps) ───────────────────────────────────────────────────────────
# Temporal: atividades/workflows nos processos bruce-core / opportunity
ENABLE_TEMPORAL_WORKER=false
# BullMQ: consumidores de eventos entre módulos (add-venture, builder, brand-aid, bruce-core)
ENABLE_BULLMQ_WORKERS=false

# ── Feature flags (convenção / roadmap em modules/) ──────────────────────────
ENABLE_HUMAN_GATE=false
# ENABLE_BILLING=false também desliga os limites de plano (legado).
# Prefira BRUCE_DISABLE_PLAN_LIMITS abaixo para intenção explícita.
ENABLE_BILLING=false
ENABLE_SMTP=false
ENABLE_VECTOR_SEARCH=true

# Desliga TODOS os limites de plano (max_ventures, max_opportunities_per_month,
# max_ai_credits_per_month) em toda a plataforma. Útil pra dev, demos internas
# e instâncias self-hosted. Quando true:
#   - enforcePlanLimits() no @bruce/auth deixa passar
#   - assertScanQuota() no opportunity module vira no-op
#   - GET /usage retorna unlimited=true e limites gigantes
# Aceita: 1/true/yes/on. Qualquer outro valor mantém enforcement.
BRUCE_DISABLE_PLAN_LIMITS=true

# ── Admin bruce-core ──────────────────────────────────────────────────────────
# IDs de utilizador Clerk (lista separada por vírgulas) com acesso a /admin/revenue
BRUCE_ADMIN_USER_IDS=

# ── URLs dos serviços por módulo (convenção local / integração futura) ───────
# Os defaults abaixo batem com PORT por app quando definido ao arrancar cada workspace.
BRUCE_CORE_PORT=3000
OPPORTUNITY_PORT=3002
ADD_VENTURE_PORT=3003
BRAND_AID_PORT=3004
BUILDER_PORT=3005
GTM_PORT=3006
STARTUP_OPS_PORT=3007
PORTFOLIO_PORT=3008
BRUCE_MEMORY_PORT=3009

BRUCE_CORE_URL=http://localhost:3000
OPPORTUNITY_URL=http://localhost:3002
ADD_VENTURE_URL=http://localhost:3003
BRAND_AID_URL=http://localhost:3004
BUILDER_URL=http://localhost:3005
GTM_URL=http://localhost:3006
STARTUP_OPS_URL=http://localhost:3007
PORTFOLIO_URL=http://localhost:3008
BRUCE_MEMORY_URL=http://localhost:3009

# API gateway (@bruce/app-api-gateway) — proxy em /services/:module/* → serviço HTTP do módulo
API_GATEWAY_PORT=3010
# BRUCE_GATEWAY_BRUCE_CORE=http://localhost:3000
# ... (override por módulo se necessário)

# ── Agent modules (monorepo) ────────────────────────────────────────────────
# Opcional: pasta `modules/` na raiz do repo. Por defeito o runtime sobe diretórios até encontrar modules/opportunity.
# BRUCE_MODULES_DIR=/absolute/path/to/bruce/modules

# ── Opportunity (@bruce/app-opportunity) ───────────────────────────────────
# Quality gate (Temporal workflow opportunityScreeningWorkflow): retry analyst+scoring até passar nota,
# ou novo candidato (novo market scan) até OPPORTUNITY_MAX_QUALITY_CANDIDATES.
# OPPORTUNITY_PASS_SCORE=70
# OPPORTUNITY_LOW_SCORE_THRESHOLD=50
# OPPORTUNITY_MAX_IMPROVE_ATTEMPTS=3
# OPPORTUNITY_MAX_QUALITY_CANDIDATES=10
# OPPORTUNITY_MINIMUM_ADVANCEMENT_SCORE=75
# Pesquisa web opcional no market-scanner (Serper.dev — não confundir com SerpApi)
SERPER_API_KEY=
# Opcional; default https://google.serper.dev/search
# SERPER_API_URL=https://google.serper.dev/search
# Agendamento semanal (Temporal Schedule) — segunda 06:00 UTC; desligado por defeito
ENABLE_WEEKLY_OPPORTUNITY_DISCOVERY=false
# Conta/org a usar no workflow agendado (mesmo formato que JWT dev: org_*)
WEEKLY_OPPORTUNITY_ACCOUNT_ID=
# JSON array de temas, ex.: ["AI infra","climate"]
WEEKLY_OPPORTUNITY_THEMES=[]

# ── Turbo / CI (opcional) ────────────────────────────────────────────────────
# TURBO_TOKEN=
# CI=true
