# =============================================================================
# BruceAI — configuração mínima para subir infra + monorepo com todos os módulos
#
# Copie para `.env` e preencha os valores vazios. Depois: `pnpm infra:up`,
# `pnpm db:migrate`, `pnpm dev` (ou serviços/workers com env adequado).
#
# Inclui só o necessário para: Postgres, Redis, Temporal, Qdrant, MinIO, LLM,
# JWT inter-módulos e event bus Redis (workers opcionais via flags abaixo).
# =============================================================================

NODE_ENV=development

# Compose na raiz (README): bruce / bruce_dev / bruce_dev_password
DATABASE_URL=postgresql://bruce:bruce_dev_password@localhost:5432/bruce_dev
REDIS_URL=redis://localhost:6379

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

QDRANT_URL=http://localhost:6333

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=bruce

# Obrigatório para chamadas JWT entre módulos (sign/verify).
INTER_MODULE_JWT_SECRET=dev-local-minimum-32-chars-secret-key

# LLM: os agentes em modules/*/capabilities.json usam sobretudo provider "openai".
# Defina pelo menos UMA destas consoante o que configurar nos agentes:
OPENAI_API_KEY=
# OU gateway OpenRouter (ajuste capabilities para provider "openrouter" + modelo OpenRouter):
# LLM_PROVIDER_MODE=openrouter
# OPENROUTER_API_KEY=

# Eventos entre módulos com Redis (recomendado com workers BullMQ ligados)
BRUCE_EVENT_BUS=redis

# Opcional: ativar workers no mesmo processo que o HTTP (senão arranque workers à parte)
# ENABLE_TEMPORAL_WORKER=true
# ENABLE_BULLMQ_WORKERS=true
